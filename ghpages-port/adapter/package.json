{
  "name": "@digitaldefiance/gitdash-pages",
  "version": "0.14.1",
  "description": "Build-side tooling for running an EmDash site on GitHub Pages, GitLab Pages, Netlify or Cloudflare Pages with content stored as JSON in the repository.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digital-Defiance/gitdash.git",
    "directory": "ghpages-port/adapter"
  },
  "homepage": "https://github.com/Digital-Defiance/gitdash/tree/main/ghpages-port/adapter#readme",
  "bugs": {
    "url": "https://github.com/Digital-Defiance/gitdash/issues"
  },
  "keywords": [
    "emdash",
    "cms",
    "github-pages",
    "gitlab-pages",
    "netlify",
    "cloudflare-pages",
    "static-site",
    "jamstack"
  ],
  "bin": {
    "gitdash-pages": "bin/gitdash-pages.mjs",
    "ghdash-pages": "bin/gitdash-pages.mjs"
  },
  "files": [
    "bin",
    "lib",
    "studio",
    "worker",
    "templates",
    "!lib/*.test.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test lib/*.test.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "exports": {
    "./studio/*": "./studio/*",
    "./worker/*": "./worker/*",
    "./package.json": "./package.json",
    "./hooks": "./lib/hooks-runner.mjs",
    "./host": "./lib/host.mjs",
    "./gitlab-comments": "./lib/gitlab-comments.mjs"
  },
  "peerDependencies": {
    "@emdash-cms/admin": "*",
    "@sqlite.org/sqlite-wasm": "*",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@emdash-cms/admin": {
      "optional": true
    },
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
